# Copy these into Vercel -> Project -> Settings -> Environment Variables.
# (For running management commands against production locally, put them in .env
#  and load them into your shell; .env is git-ignored.)

# Required
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Uploaded images (Supabase Storage, S3-compatible)
MEDIA_BUCKET=media
MEDIA_ENDPOINT_URL=https://<project-ref>.supabase.co/storage/v1/s3
MEDIA_REGION=<region, e.g. ap-south-1>
MEDIA_ACCESS_KEY_ID=<storage access key id>
MEDIA_SECRET_ACCESS_KEY=<storage secret access key>
MEDIA_PUBLIC_DOMAIN=<project-ref>.supabase.co/storage/v1/object/public/media

# Optional
# DJANGO_ALLOWED_HOSTS=.vercel.app,www.yourdomain.com
# DJANGO_CSRF_TRUSTED_ORIGINS=https://*.vercel.app,https://www.yourdomain.com
# DJANGO_DEBUG=False
